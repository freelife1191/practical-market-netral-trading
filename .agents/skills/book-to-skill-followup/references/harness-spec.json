        "source-audit"
      ],
      "outputs": [
        "skill-refinement"
      ],
      "parallel_group": null,
      "completion": "단계별 references/evidence-contract.md 계약을 충족하고 실제 파일·해시·판정이 확인된다.",
      "required": true
    },
    {
      "id": "documentation",
      "owner": "coordinator",
      "depends_on": [
        "skill-refinement"
      ],
      "inputs": [
        "request",
        "source",
        "skill-refinement"
