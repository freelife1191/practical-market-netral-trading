  "review_policy": {
    "reviewer": "release-reviewer",
    "max_revisions": 2,
    "block_on": [
      "critical",
      "high"
    ]
  },
  "failure_policy": {
    "retry_limit": 1,
    "required_failure": "stop",
    "optional_failure": "partial",
    "timeout": "호스트 600초, 개별 도구 120초. 시간 초과 기록 후 필수 작업 중단; 호스트 자동 재호출 없음."
  },
  "evidence_policy": {
    "sources_required": true,
    "effective_date_required": false,
    "jurisdiction_required": false,
    "uncertainty_required": true,
    "human_review_required": false
  }
}
